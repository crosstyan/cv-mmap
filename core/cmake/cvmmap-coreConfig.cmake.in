@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(cppzmq REQUIRED)
find_dependency(spdlog REQUIRED)
if(NOT @CVMMAP_HAS_STD_FORMAT@)
	find_dependency(fmt REQUIRED)
endif()
if(NOT @CVMMAP_HAS_STD_EXPECTED@)
	find_dependency(tl-expected CONFIG REQUIRED)
endif()
find_dependency(Threads REQUIRED)
find_dependency(OpenSSL REQUIRED)
find_dependency(cnats REQUIRED)

# Optional NATS + protobuf dependencies (present when cvmmap_nats was built)
find_dependency(Protobuf REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/cvmmap-coreTargets.cmake")
