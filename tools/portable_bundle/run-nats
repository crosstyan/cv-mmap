#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<'EOF'
Usage:
  run-nats [nats-server args...]

Launch the bundled nats-server executable from any working directory.
EOF
}

die() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

script_dir="$(cd -- "$(dirname -- "$0")" && pwd -P)"
readonly script_dir
bundle_root="$(cd -- "$script_dir/.." && pwd -P)"
readonly bundle_root
binary="$bundle_root/tools/nats-server"

[[ -x "$binary" ]] || die "bundled NATS executable not found: $binary"

if [[ "${1-}" == "--help" || "${1-}" == "-h" ]]; then
  usage
fi

exec "$binary" "$@"
